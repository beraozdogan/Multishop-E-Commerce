@model List<MultiShop.RapidApiWebUI.Models.ECommerceViewModel.Product>

@{
    Layout = null;
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="mb-4">Ürün Listesi</h2>
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Fotoğraf</th>
                <th>Ürün Başlığı</th>
                <th>Ürün Puanı</th>
                <th>Ürün Fiyatı</th>
                <th>Detay</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.product_photo" width="80" height="80" alt="fotoğraf" />
                    </td>
                    <td>@item.product_title</td>
                    <td>@item.product_rating</td>
                    <td>@item.price</td>
                    <td>
                        <a href="@item.product_offer_page_url" target="_blank" class="btn btn-primary btn-sm">
                            Ürün Detayları
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
